# Resend API key — create one at https://resend.com after verifying the lminventories.co.uk domain
RESEND_API_KEY=

# Address enquiries are forwarded to
CONTACT_TO_EMAIL=info@lminventories.co.uk

# Address enquiries appear to be sent from — must be on a domain verified with Resend
CONTACT_FROM_EMAIL=enquiries@lminventories.co.uk

# Port the server listens on (Railway sets this automatically in production)
PORT=3000
